{
  "name": "C# + Angular + Aspire DevContainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // Docker-in-Docker (Required for Aspire)
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true
    },
    // Official .NET SDK
    "ghcr.io/devcontainers/features/dotnet:1": {
      "version": "9.0"
    },
    // Node.js for Angular
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "nodeGypDependencies": true
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "Angular.ng-template",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode"
      ]
    }
  },

  "forwardPorts": [18888, 4200, 5000, 5001, 8080],

  // Install Aspire, Angular CLI, and trust development certificates
  "postCreateCommand": "dotnet workload update && dotnet workload install aspire && npm install -g @angular/cli && dotnet dev-certs https --trust",

  "remoteUser": "vscode"
}
